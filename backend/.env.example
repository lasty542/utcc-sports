PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/utcc_sports
JWT_SECRET=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:5173
# Email domains allowed (* or empty allows all emails including @gmail.com, @hotmail.com, etc.)
ALLOWED_EMAIL_DOMAINS=*

# Optional: SMTP for real password reset emails (Microsoft 365 / Gmail)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: Microsoft Entra ID (Azure AD) OAuth 2.0 (Leaves blank for Demo/Mock mode)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/auth/microsoft/callback

# Optional: Google OAuth 2.0 (Leaves blank for Demo/Mock mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
